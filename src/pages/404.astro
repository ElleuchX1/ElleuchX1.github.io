---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="wrap">
    <div class="article">
      <header class="article-head">
        <span class="label">404</span>
        <h1>Page not found</h1>
      </header>
      <p class="soft">
        That page doesn't exist. <a href="/">Back home</a>.
      </p>
    </div>
  </div>
</BaseLayout>
